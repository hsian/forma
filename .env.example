# 本项目独立的 AI 设置，和其他项目无关。默认使用本机 Codex 登录。
# 默认只允许本机访问；多人共用同一服务时可设置 HOST=0.0.0.0。
# HOST=127.0.0.1
# PORT=3000
FORMA_AI_PROVIDER=auto
# 可选：绝对路径；npm 全局安装通常能自动找到，无需填写。
# FORMA_CODEX_CLI=C:/path/to/codex.exe
# FORMA_CLAUDE_CLI=C:/path/to/claude.exe
# FORMA_CODEX_MODEL=your-model
# FORMA_CLAUDE_MODEL=your-model
FORMA_AI_TIMEOUT_MS=120000
# 如需沿用 CLI 原有代理/传输行为，可将对应项设为 false。
FORMA_CODEX_SYSTEM_PROXY=true
FORMA_CODEX_DISABLE_WEBSOCKETS=true
