{
  "name": "forma-prototype-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/index.ts --development",
    "build": "tsc --noEmit && vite build && vite build --config vite.offline.config.ts",
    "start": "tsx server/index.ts --production",
    "mcp": "tsx server/mcp/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "npm run build && node tests/run-browser.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx server/db/migrate.ts --development",
    "db:migrate:production": "tsx server/db/migrate.ts --production"
  },
  "dependencies": {
    "@ant-design/icons": "^6.0.0",
    "@fastify/middie": "^9.0.0",
    "@fastify/static": "^8.0.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "antd": "^5.27.0",
    "better-sqlite3": "^13.0.3",
    "dayjs": "^1.11.23",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-moveable": "^0.56.0",
    "react-selecto": "^1.26.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^6.1.0"
  }
}
